# Copy this file to trading/.env and fill in your own values. Never commit .env.
#
# TRADOVATE_ENV controls which server you hit - leave as "demo" until the strategy
# has been watched running on paper for a while and you deliberately want to go live.
TRADOVATE_ENV=demo

# Your normal Tradovate login (same as the web/desktop app).
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=

# API credentials issued by Tradovate for third-party/API access - request these from
# Tradovate support (see docs/CONNECT_TRADOVATE.md). NOT the same as your login password.
TRADOVATE_CID=
TRADOVATE_SEC=

# Free-form identifiers, safe to leave as defaults.
TRADOVATE_APP_ID=SecondBrainTrader
TRADOVATE_APP_VERSION=1.0
TRADOVATE_DEVICE_ID=second-brain-trader-1
